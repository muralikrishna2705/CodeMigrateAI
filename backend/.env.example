# Copy to backend/.env and fill in. Every value here is optional except the API
# key for whichever hosted provider you select.

# --- Model provider ---------------------------------------------------------
# "google_genai" (Gemini / AI Studio) or "ollama".
#
# The default is hosted because native tool calling is what makes the agentic
# paths work at all: Ollama's /api/generate has no `tools` parameter, and
# deepseek-coder:1.3b reports capabilities ["completion"] — no tool support.
LLM_PROVIDER=google_genai

# Required for google_genai. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Leave empty to use the provider's defaults (gemini-2.5-flash /
# gemini-2.5-flash-lite for Gemini; deepseek-coder:1.3b / llama3.2:3b for
# Ollama). Set explicitly to pin a model.
LLM_MODEL=
FAST_LLM_MODEL=

# --- Rate limiting ----------------------------------------------------------
# THIS IS LOAD-BEARING on a free tier. Quotas are quoted per MINUTE and one
# migration makes 8-15 model calls, so an unthrottled parallel fan-out will 429
# before it finishes a single run.
#
#   Gemini free tier  ~10 RPM  -> 0.16
#   Gemini paid tier  ~1000 RPM -> 16.0
#   Ollama (local, CPU-bound)   -> 0
#
# Verify your project's actual quota before raising this.
LLM_REQUESTS_PER_SECOND=0.16
LLM_MAX_BURST=4

# --- Embeddings -------------------------------------------------------------
# Independent of the chat provider: embedding a corpus locally while generating
# with a hosted model is a reasonable split. Hosted embeddings are dramatically
# faster for ingestion on a machine without a GPU.
EMBEDDING_PROVIDER=google_genai
EMBEDDING_MODEL=

# --- Ollama (only used when a provider above is set to "ollama") ------------
OLLAMA_URL=http://host.docker.internal:11434

# --- Optional services ------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
VALIDATOR_URL=http://validator:8000
